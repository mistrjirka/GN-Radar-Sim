extends SceneTree
## Pure-state tests: chart projection, scan lock/envelope and coordinate-only effects.
const Chart=preload("res://game/cockpit/paper_chart.gd")
const Geo=preload("res://game/cockpit/scan_geometry.gd")
const Acquisition=preload("res://game/cockpit/radar_acquisition.gd")
const State=preload("res://game/cockpit/mission_state.gd")
const Scope=preload("res://game/cockpit/range_receiver.gd")
var passed:=0
var failed:=0
func check(value:bool,label:String) -> void:
	if value:passed+=1;print("PASS ",label)
	else:failed+=1;push_error(label)

func _initialize() -> void:
	var c=Chart.new();c.size=Vector2(640,800);c.endless=true;c.aircraft=Vector2(1700,-2100)
	c.change_extent(1600)
	for angle in [0.0,PI/2,PI,-PI/2,0.73]:
		c.heading=angle
		var forward:=Vector2(sin(angle),cos(angle))
		check(c.world_to_screen(c.aircraft).distance_to(Vector2(320,648))<.001,"Aircraft fixed at bottom-center at heading "+str(angle))
		check(c.world_to_screen(c.aircraft+forward*1000).distance_to(c.anchor()+Vector2(0,-1000*c.scale_px))<.001,"Heading-up projects actual forward direction upward")
		var p:=Vector2(435,-325)
		check(c.screen_to_world(c.world_to_screen(p)).distance_to(p)<.003,"Chart click round trip after rotation")
	c.heading=.73;c.select(c.aircraft+Vector2(sin(.73),cos(.73))*2500)
	var selected:Vector2=c.selected_center;var view:Vector2=c.world_to_screen(selected)
	var corners:PackedVector2Array=c.selection_corners();var rect:Rect2=c.selection_rect()
	c.lock_acquisition()
	c.aircraft+=Vector2(350,420);c.heading+=.4;c.follow_paper()
	check(c.selected_center==selected and c.selection_rect()==rect,"Acquiring never moves guide positions or selected terrain")
	check(c.world_to_screen(selected)==view and c.selection_corners()==corners,"Map origin AND rotation remain latched during a scan")
	var scale:float=c.scale_px;c.change_extent(4000);c.cycle_scale();c.select(Vector2.ZERO)
	check(c.selected_extent==1600 and c.scale_px==scale and c.selected_center==selected,"Area, zoom and selection are inhibited until scan write completes")
	c.selected_center-=Vector2(4096,4096);c.aircraft-=Vector2(4096,4096);c.rebase_acquisition(Vector2(4096,4096))
	check(c.world_to_screen(c.selected_center).distance_to(view)<.001,"Floating-origin shift does not move the acquired image on paper")
	c.unlock_acquisition();check(not c.acquisition_locked and c.projection_heading()==c.heading,"Paper resumes heading-up motion after acquisition")
	c.free()
	check(Geo.inhibit_reason([0,0,1250],0,[0,3000],1600)=="","Forward square allowed")
	check(not Geo.inhibit_reason([0,0,1250],0,[0,0],1600).is_empty(),"Self / nadir scan rejected")
	check(not Geo.inhibit_reason([0,0,1250],0,[0,-4000],1600).is_empty(),"Rear scan rejected")
	check(not Geo.inhibit_reason([0,0,1250],0,[4000,1000],1600).is_empty(),"Sideways scan rejected")
	check(not Geo.inhibit_reason([0,0,1250],0,[0,2000],4000).is_empty(),"Valid center does not excuse rear/near corners")
	check(Geo.inhibit_reason([0,0,1250],PI/2,[3000,0],1600)=="","Forward envelope rotates with aircraft")
	check(not Geo.inhibit_reason([0,0,1250],0,[0,11900],1600).is_empty(),"Range guard includes the farthest corner")
	var a=Acquisition.new();a.begin(7,[0,0,1250],PI/2,[3000,0],1600,"detail")
	check(not a.receive({"id":6}),"Late frame from a different request ignored")
	check(a.receive({"id":7,"center":[3000,0],"extent":1600}),"Correct acquisition enters CRT resolving")
	check(not a.can_designate(),"No designations on a partly-resolved image")
	a.advance(.6);check(a.progress>0 and a.progress<1,"CRT progresses gradually rather than instant replacement")
	a.advance(5);check(a.can_designate() and a.frame["heading"]==PI/2,"Completed frame retains its own acquisition orientation")
	var world:Array=Geo.sample_to_world(Vector2(.5,0),a.frame)
	check(absf(world[0]-3800)<.001 and absf(world[1])<.001,"Radar top maps forward in the stored, not current, orientation")
	check(Geo.sample_to_world(Vector2(-.1,.5),a.frame).is_empty(),"Outside-screen designation rejected")
	a.begin(8,[0,0,1250],0,[0,3000],1600,"map");a.fail()
	check(a.can_designate() and a.frame["id"]==7,"Worker failure preserves previous complete frame")
	var m=State.new();m.setup({"scenario":"endless","start":[0,0],"target":[0,0],"egress":[0,0],"seed":42,"suspected":[],"emitters":[
		{"id":4,"position":[0,8000],"power":.70,"phase":0,"disabled":false},
		{"id":5,"position":[1000,15000],"power":.8,"phase":0,"disabled":false}]});m.begin()
	check(m.receiver_contacts().size()==2,"Sites are detected at 8 km and 15 km")
	var contact:Dictionary=m.receiver_contacts()[0]
	check(contact.has("estimated_range_m") and not contact.has("position") and not contact.has("distance"),"RWR receives an estimate, not precise world position")
	check(absf(contact["estimated_range_m"]-8000)>100,"Power variation makes the estimate non-exact")
	check(not m.fire_coordinate(),"No invisible target / automatic emitter launch")
	m.toggle_arm();m.designate_radar_point([900,8000],7)
	check(m.fire_coordinate(),"Launch travels to the player coordinate")
	var stores:int=m.arm_count
	check(not m.fire_coordinate() and m.arm_count==stores,"Duplicate launch cannot spend another round")
	m.designate_radar_point([0,8000],7)
	check(m.coordinate_weapon.destination==[900,8000],"Retargeting display cannot home an already-launched projectile")
	for i in range(50):m.tick(.5)
	check(not m.emitters[0]["disabled"],"Missing a site does not snap the impact to it")
	m.designate_radar_point([0,8000],7);check(m.fire_coordinate(),"A second coordinate can be fired independently")
	for i in range(50):m.tick(.5)
	check(m.emitters[0]["disabled"] and not m.emitters[1]["disabled"],"Only a site inside the fictional impact area is silenced")
	m.setup({"scenario":"endless","start":[0,0],"target":[0,0],"egress":[0,0],"emitters":[],"suspected":[]})
	check(m.designated_point.is_empty() and m.coordinate_impacts.is_empty() and not m.coordinate_weapon.active,"Restart clears all targeting/projectile state")
	var r=Scope.new();r.size=Vector2(512,512)
	check(r.contact_point({"bearing":0,"estimated_range_m":4000}).y>r.contact_point({"bearing":0,"estimated_range_m":16000}).y,"RWR radius expresses nearer / farther estimated range")
	r.free()
	print("PLAYABILITY_TESTS ",JSON.stringify({"passed":passed,"failed":failed}))
	quit(0 if failed==0 else 1)
